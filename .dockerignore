# Keep secrets and local cruft OUT of the image build context. `.gitignore` does
# NOT affect `docker build`, so without this the `COPY . .` in the Dockerfile
# would bake .env (real keys) and the whole .git history into image layers.
.env
.env.*
!.env.example
.git
.gitignore
node_modules
.next
npm-debug.log*
*.log

# Dev/test artifacts that don't belong in a build.
.playwright-mcp
coverage
tsconfig.tsbuildinfo
.vscode
.idea
.DS_Store
