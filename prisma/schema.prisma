// HR Platform starter — data model.
// Note: pgvector's `halfvec` column is declared via Prisma's `Unsupported` type.
// The HNSW index over it is created in the Prisma migration
// (`prisma/migrations/0_init`), since Prisma can't model an index on it.

generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A role is data, not an enum: super admins define custom roles at runtime.
/// `permissions` is NULL on a built-in role, meaning "use the code defaults" in
/// `lib/rbac.ts` (DEFAULT_ROLE_PERMISSIONS) — so the built-in matrix has exactly
/// one source of truth and this table can never drift from it. "Reset to
/// defaults" is just setting it back to NULL. A custom role always carries an
/// explicit array. Unknown strings in that array are dropped on read, so the
/// permission VOCABULARY stays code-defined and a form can't invent one.
model Role {
slug String @id // "EMPLOYEE", "AUDITOR" — the stable key stored on User.role
label String // display name; user data, untranslated (like KbCollection.name)
description String?
builtIn Boolean @default(false) // built-ins can't be deleted and their slug is immutable
rank Int @default(0) // display order
permissions Json? // Permission[] — NULL on a built-in = use the code defaults
updatedById String? // raw id, audit-style (no FK) — matches PredictiveWeightConfig
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
users User[]
}

enum LeaveType {
VACATION
SICK
PERSONAL
}

enum LeaveStatus {
PENDING
APPROVED
REJECTED
}

/// Auth identity. One User maps to one Employee profile.
model User {
id String @id @default(cuid())
email String @unique
name String
// Nullable so passwordless-only accounts (magic link / OTP / Google) can exist
// without a password                                                                ; credentials login simply fails when it is null.
passwordHash String?
// The role SLUG, and the FK to it. `onDelete: Restrict` makes "reassign the
// users before deleting a role" a database guarantee, not just a UI check.
role String @default("EMPLOYEE")
roleRef Role @relation(fields: [role], references: [slug], onDelete: Restrict)
// Account state, distinct from Employee.status: offboarding ARCHIVES the employee
// record, this disables the LOGIN. Enforced in both credentials authorize()
// callbacks, the Google signIn callback, and per-request in requireUser().
active Boolean @default(true)
deactivatedAt DateTime?
emailVerified DateTime? // set the first time an email OTP / magic link is confirmed
employee Employee?
createdAt DateTime @default(now())
kbCreated HrDocument[] @relation("KbCreatedBy")
kbUpdated HrDocument[] @relation("KbUpdatedBy")
kbFeedback KbFeedback[]
aiEvents AiEvent[]
alertsRaised Alert[] @relation("AlertSubject")
alertsAcked Alert[] @relation("AlertAck")
alertsResolved Alert[] @relation("AlertResolved")

// HARI-88: document generation back-relations.
documentsRequested GeneratedDocument[] @relation("DocumentRequester")
documentsValidated GeneratedDocument[] @relation("DocumentValidator")

// Prisma doesn't index relation scalars on PostgreSQL. The admin user list
// filters by role, and the Restrict FK checks it on every role delete.
@@index([role])
}

/// HR profile / org data.
model Employee {
id String @id @default(cuid())
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
userId String @unique
title String
department String
location String
startDate DateTime
status EmploymentStatus @default(ACTIVE)
employmentType EmploymentType @default(FULL_TIME)
salary Int // annual, in the org's configured currency (see OrgSettings) — sensitive: only HR/Super can read via tools
avatarUrl String?

// SCRUM-098 (predictive analytics). Denormalized/derived signal anchors:
lastReviewDate DateTime? // latest PerformanceReview.reviewDate (hot-path denormalization)
lastRoleChangeDate DateTime? // last title/role change → months-in-role                      ; falls back to startDate
leftAt DateTime? // set when status → TERMINATED                                             ; feeds dept turnover + the domino effect
// HR analytics (HARI-122 / SCRUM-097). All nullable/defaulted — additive, never
// read by name-facing surfaces                                                                ; only the RBAC-gated analytics layer aggregates them.
birthDate DateTime? // for the age pyramid (aggregated into bands, never shown raw)
gender Gender? // diversity split                                                              ; optional, self-declared
contractType ContractType @default(CDI) // CDI/CDD/… — orthogonal to employmentType (time)
timeToHireDays Int? // days between requisition open and arrival — recruitment KPI
terminationDate DateTime? // set when status = TERMINATED — powers turnover over time
departureReason DepartureReason? // why they left — turnover breakdown

// Self-referential org chart.
manager Employee? @relation("Reports", fields: [managerId], references: [id])
managerId String?
reports Employee[] @relation("Reports")

leaveBalances LeaveBalance[]
leaveRequests LeaveRequest[] @relation("Requester")
approvals LeaveRequest[] @relation("Approver")
// SCRUM-098 (predictive analytics)
salaryChanges SalaryChange[]
engagementSurveys EngagementSurvey[]
riskSnapshots DepartureRiskSnapshot[]
// SCRUM-099 (engagement & burnout)
engagementSnapshots EngagementSnapshot[]
qualitativeSignals QualitativeSignal[] @relation("QualSubject")
oneOnOnes OneOnOne[] @relation("CheckInSubject")
// SCRUM-097 (HR analytics). Reviews are unified into one PerformanceReview model
// (subject + reviewer)                                                           ; SCRUM-098's rating lives there too.
payrollSnapshots PayrollSnapshot[]
reviewsReceived PerformanceReview[] @relation("ReviewSubject")
reviewsGiven PerformanceReview[] @relation("Reviewer")

// Predictive/turnover query paths (SCRUM-098): active-headcount and departure
// aggregates filter on status/department/leftAt every batch pass, and the manager
// risk scope filters managerId+status. Without these the groupBy/count sequential-scan.
@@index([status, department])
@@index([leftAt])
@@index([managerId, status])
// SCRUM-095 / SCRUM-096 (onboarding / offboarding)
onboardingTasks OnboardingTask[]
offboarding Offboarding?
}

model LeaveBalance {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
type LeaveType
totalDays Int
usedDays Int @default(0)

@@unique([employeeId, type])
}

model LeaveRequest {
id String @id @default(cuid())
employee Employee @relation("Requester", fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
type LeaveType
startDate DateTime
endDate DateTime
days Int
reason String? // the requester's stated reason for the leave
decisionNote String? // the approver's note (required on rejection) — SCRUM-071 B1
status LeaveStatus @default(PENDING)
approver Employee? @relation("Approver", fields: [approverId], references: [id])
approverId String?
createdAt DateTime @default(now())
}

/// Org-wide settings, a single row (id = "singleton"). Editable by a super admin
/// in Settings                                                                   ; drives currency formatting and the timezone the AI reasons in.
model OrgSettings {
id String @id @default("singleton")
currency String @default("MAD")
timezone String @default("UTC")
updatedAt DateTime @updatedAt
}

/// Knowledge-base lifecycle. Only PUBLISHED documents feed the RAG (HARI-62).
enum DocStatus {
DRAFT
PUBLISHED
ARCHIVED
}

/// Per-document access level (HARI-59). Mapped to roles via visibleDocTiers().
enum DocVisibility {
ALL_EMPLOYEES
MANAGERS
HR_ONLY
}

/// A KB collection groups related HR documents (e.g. "Employee Handbook").
model KbCollection {
id String @id @default(cuid())
slug String @unique
name String
description String?
image String? // optional decorative cover (data URL or external URL)
order Int @default(0)
assistantEnabled Boolean @default(true) // may the AI assistant draw on this collection? (super-admin policy)
documents HrDocument[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

/// HARI-58: an HR document usable by the RAG. Markdown body, chunked on publish.
model HrDocument {
id String @id @default(cuid())
slug String @unique
title String
content String // HTML source of truth (authored in BlockNote)
status DocStatus @default(DRAFT)
visibility DocVisibility @default(ALL_EMPLOYEES)
version Int @default(1) // bumped each publish (HARI-59)
tags String[] @default([]) // freeform topic tags
viewCount Int @default(0) // reader views (engagement signal)
assistantEnabled Boolean? // AI-assistant override: null = inherit collection, true = force on, false = force off
collection KbCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
collectionId String
chunks HandbookChunk[]
// Authorship (shown on the reader + admin). SetNull so deleting a user keeps docs.
createdBy User? @relation("KbCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
createdById String?
updatedBy User? @relation("KbUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
updatedById String?
feedback KbFeedback[]
publishedAt DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@index([collectionId])
@@index([status])
}

/// "Was this helpful?" — one vote per (document, user)                                ; re-voting updates it.
model KbFeedback {
id String @id @default(cuid())
document HrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
documentId String
voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)
voterId String
helpful Boolean
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@unique([documentId, voterId])
}

/// RAG chunks. `embedding` is a pgvector halfvec(384). HARI-59: each chunk is
/// attached to its document, version, and (denormalized) access level so
/// retrieval can filter by tier without a join on the hot path.
model HandbookChunk {
id String @id @default(cuid())
section String // heading text
anchor String @default("") // slug of the heading → citation deep-link
content String
chunkIndex Int @default(0) // order within the document
embedding Unsupported("halfvec(384)")?
// Generated tsvector for lexical (full-text) search — the lexical half of hybrid
// retrieval. The GENERATED expression + GIN index live in the migration SQL
// (Prisma can't model either), like the halfvec column + HNSW index.
contentTsv Unsupported("tsvector")?
document HrDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
documentId String?
version Int @default(1)
visibility DocVisibility @default(ALL_EMPLOYEES)
createdAt DateTime @default(now())

@@index([documentId])
}

enum EmploymentStatus {
ACTIVE
ON_LEAVE
TERMINATED
}

enum EmploymentType {
FULL_TIME
PART_TIME
CONTRACTOR
}

// ─────────────────────────────────────────────────────────────────────────
// HR analytics dimensions + facts (HARI-122 / SCRUM-097)
// ─────────────────────────────────────────────────────────────────────────

enum Gender {
FEMALE
MALE
OTHER
}

/// Nature of the employment contract (fr labour taxonomy) — distinct from
/// EmploymentType (which is about working time). Used by the contract filter.
enum ContractType {
CDI // permanent
CDD // fixed-term
ALTERNANCE // work-study
STAGE // internship
}

/// Why an employee left — drives the turnover breakdown.
enum DepartureReason {
VOLUNTARY // resignation
INVOLUNTARY // dismissal
RETIREMENT
END_OF_CONTRACT // CDD/stage reached its term
}

/// One month of gross pay for one employee — the fact table behind the payroll
/// evolution curve and historical department breakdown (salary alone is a single
/// current snapshot, so it can't show 12-month trends).
model PayrollSnapshot {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
month DateTime // first day of the month (UTC)
grossAmount Int // gross pay for that month, in the org currency

@@unique([employeeId, month])
@@index([month])
}

/// A conducted annual review ("entretien annuel"). Powers review-coverage KPIs
/// (HARI-122) and the time-since-last-review engagement signal (HARI-124).
model PerformanceReview {
id String @id @default(cuid())
employee Employee @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
reviewer Employee? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
reviewerId String?
conductedAt DateTime
rating Int? // SCRUM-098: optional 1–5 rating (explicability only, never copied into an alert)
createdAt DateTime @default(now())

@@index([employeeId])
@@index([conductedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AI observability + guardrails (SCRUM-062 / SCRUM-063)
// ─────────────────────────────────────────────────────────────────────────

/// Kind of AI interaction event traced. Metadata only — never message content.
enum AiEventKind {
TURN // one assistant turn completed (usage/latency/finishReason)
TOOL_CALL // a tool was invoked
REFUSAL // a tool refused (permission / in-body authorization)
GUARD_BLOCK // deterministic input guard blocked the request before the model
CONVERSATION_CLOSED // the assistant ended the chat via endConversation
ERROR // model/stream error
}

/// SCRUM-062: a trace of one AI interaction. Deliberately stores only metadata
/// (role, model, token counts, codes) — NEVER the prompt/response text, names,
/// or salary — so tracing can't leak sensitive HR data.
model AiEvent {
id String @id @default(cuid())
createdAt DateTime @default(now())
conversationId String // opaque client uuid grouping a chat — not content
user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
userId String?
// Actor role SLUG, denormalized so it survives user deletion. Deliberately a
// plain String with NO FK to Role: a historical event must survive the role
// itself being deleted, so readers fall back to the raw slug for a label.
role String
kind AiEventKind
model String?
inputTokens Int?
outputTokens Int?
totalTokens Int?
latencyMs Int?
stepCount Int?
finishReason String?
toolName String? // for TOOL_CALL / REFUSAL
errorCode String? // ChatErrorCode / tool errorCode
guardRule String? // which guardrail fired (GUARD_BLOCK)
reasonCode String? // endConversation reason (CONVERSATION_CLOSED)
meta Json? // small structured extras — no PII
alerts Alert[]

@@index([conversationId])
@@index([createdAt])
@@index([kind])
@@index([userId])
}

/// Category of an actionable alert raised for Admin/HR.
enum AlertKind {
AI_REFUSAL // repeated refusals in a conversation
AI_GUARD_BLOCK // deterministic guard blocked a request
AI_ERROR // model/stream failure
CONVERSATION_CLOSED // the assistant ended a chat
DEPARTURE_RISK // SCRUM-098: computed departure-risk score above the alert threshold
ENGAGEMENT_RISK // SCRUM-099: daily engagement score crossed the alert threshold
}

enum AlertSeverity {
INFO
WARNING
CRITICAL
}

enum AlertStatus {
OPEN
ACKNOWLEDGED
RESOLVED
}

/// SCRUM-063: an actionable alert for Admin/HR (gated by `alerts:read`). Stores
/// an i18n key + small params, not localized/sensitive text, so it honors the
/// same no-PII contract as AiEvent and the app's mandatory-i18n rule.
model Alert {
id String @id @default(cuid())
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
kind AlertKind
severity AlertSeverity @default(WARNING)
status AlertStatus @default(OPEN)
titleKey String // i18n key: alerts.kind.<x>.title
params Json? // small i18n params (role, model, count) — no PII
href String? // deep link (e.g. /alerts)
subject User? @relation("AlertSubject", fields: [subjectId], references: [id], onDelete: SetNull)
subjectId String? // actor that triggered it
aiEvent AiEvent? @relation(fields: [aiEventId], references: [id], onDelete: SetNull)
aiEventId String?
acknowledgedBy User? @relation("AlertAck", fields: [ackById], references: [id], onDelete: SetNull)
ackById String?
resolvedBy User? @relation("AlertResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
resolvedById String?
resolvedAt DateTime?

@@index([status])
@@index([createdAt])
@@index([kind])
}

/// Hardening: fixed-window rate-limit counters for abuse-prone endpoints
/// (credential login, auth-email issuance, chat, KB upload/search). Keyed by a
/// `bucket` + an opaque `key` (ip and/or normalized email / userId) + the window
/// start; `count` is the number of hits in that window. Metadata only. Stale rows
/// are harmless and may be pruned by a periodic job.
model RateLimit {
id          String   @id @default(cuid())
bucket      String
key         String
windowStart DateTime
count       Int      @default(0)

@@unique([bucket, key, windowStart])
@@index([windowStart])
}

/// SCRUM-064: the sensitive actions worth recording for after-the-fact review.
enum AuditAction {
ALERT_ACKNOWLEDGED
ALERT_RESOLVED
ALERT_REOPENED
ALERTS_CONSOLE_VIEWED
// SCRUM-096: offboarding lifecycle (compliance trail).
OFFBOARDING_INITIATED
OFFBOARDING_STEP_COMPLETED
EMPLOYEE_OFFBOARDED
// SCRUM-100: further significant actions + access to the audit console itself.
LEAVE_APPROVED
LEAVE_REJECTED
AUDIT_CONSOLE_VIEWED
// SCRUM-080: HR decision on a generated-document request.
DOCUMENT_VALIDATED
DOCUMENT_REJECTED
// Knowledge-base management (kb:manage) — these change what the AI RAG serves to
// the whole org, so they belong on the sensitive-action trail like the rest.
KB_COLLECTION_CREATED
KB_COLLECTION_UPDATED
KB_COLLECTION_DELETED
KB_DOCUMENT_CREATED
KB_DOCUMENT_UPDATED
KB_DOCUMENT_PUBLISHED
KB_DOCUMENT_UNPUBLISHED
KB_DOCUMENT_ARCHIVED
KB_DOCUMENT_DELETED
// Configurable RBAC (admin:settings) — editing a role rewrites what EVERY holder
// of it may do, so it is the most sensitive action on the trail.
ROLE_CREATED
ROLE_UPDATED
ROLE_DELETED
// User management (employee:manage). Roles are codes, not PII, so a role change
// records meta: { from, to } — never the target's name or email.
USER_INVITED
USER_UPDATED
USER_ROLE_CHANGED
USER_DEACTIVATED
USER_REACTIVATED
}

/// SCRUM-064: a minimal audit trail of sensitive admin/security actions (alert
/// triage + alerts-console access). Metadata only — never full confidential
/// content — mirroring the AiEvent/Alert no-PII contract. The actor and target
/// are stored as raw ids with a denormalized role, so the trail deliberately
/// SURVIVES user/target deletion (an audit record must persist)                  ; it soft-links
/// to an Alert / AiEvent by id when relevant.
model AuditLog {
id String @id @default(cuid())
createdAt DateTime @default(now())
actorId String? // who performed it (raw id                                       ; kept even if the user is later deleted)
// Actor role SLUG, denormalized so the trail survives user deletion. Plain
// String with NO FK, for the same reason as AiEvent.role.
actorRole String
action AuditAction
targetType String? // e.g. "Alert"
targetId String? // opaque id of the target — never content
alertId String? // linked alert (soft reference)
aiEventId String? // linked AiEvent (soft reference)
meta Json? // small structured extras — no PII

@@index([createdAt])
@@index([action])
@@index([actorId])
}

/// SCRUM-095: category of an onboarding step, for grouping + iconography.
enum OnboardingCategory {
PAPERWORK
EQUIPMENT
ACCESS
TRAINING
ORIENTATION
}

enum OnboardingStatus {
PENDING
DONE
}

/// SCRUM-095: one step of a new hire's personalized onboarding checklist. The
/// step label is a stable i18n `key` (onboarding.steps.<key>) — not free text —
/// so the checklist is fully localized, consistent with the mandatory-i18n rule.
model OnboardingTask {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
key String // i18n step key → onboarding.steps.<key>
category OnboardingCategory
order Int @default(0)
status OnboardingStatus @default(PENDING)
completedAt DateTime?
createdAt DateTime @default(now())

@@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────
// SCRUM-096: offboarding — the compliant exit workflow. When someone leaves, HR
// runs a checklist of exit steps (revoke access, recover equipment, final pay,
// handover, exit interview) and then ARCHIVES the employee (status → TERMINATED)
// rather than deleting them, so records are retained for conformité. Every
// significant step is written to the AuditLog (SCRUM-064) — metadata only.
// ─────────────────────────────────────────────────────────────────────────

/// Why the employee is leaving. A code, never free text — no PII.
enum OffboardingReason {
RESIGNATION
TERMINATION
END_OF_CONTRACT
RETIREMENT
OTHER
}

enum OffboardingState {
IN_PROGRESS
COMPLETED
}

enum OffboardingTaskStatus {
PENDING
DONE
}

/// Category of an exit step, for grouping + iconography.
enum OffboardingCategory {
ACCESS
EQUIPMENT
PAYROLL
KNOWLEDGE
EXIT
}

/// One offboarding process per employee (`employeeId @unique`). Completing it
/// archives the employee                                                              ; the row itself is kept for the compliance trail.
model Offboarding {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String @unique
reason OffboardingReason
state OffboardingState @default(IN_PROGRESS)
lastDay DateTime
initiatedById String? // soft id of the HR actor — survives user deletion
createdAt DateTime @default(now())
completedAt DateTime?
tasks OffboardingTask[]

@@index([state])
}

model OffboardingTask {
id String @id @default(cuid())
offboarding Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
offboardingId String
key String // i18n step key → offboarding.steps.<key>
category OffboardingCategory
order Int @default(0)
status OffboardingTaskStatus @default(PENDING)
completedAt DateTime?

@@index([offboardingId])
}

// ─────────────────────────────────────────────────────────────────────────
// SCRUM-098 — Predictive workforce analytics ("Pragmatic ML-Lite").
// The scoring math lives in `lib/predictive/departure-risk.ts` (pure)                                                                                                                                                         ; these
// tables hold the SIGNALS it reads and the SNAPSHOTS it writes. Snapshots +
// alerts store only scores/bands/factor breakdowns — never names or salary —
// mirroring the AiEvent/Alert no-PII contract.
// ─────────────────────────────────────────────────────────────────────────

/// Risk map band. LOW = green, MEDIUM = orange, HIGH = red.
enum RiskBand {
LOW
MEDIUM
HIGH
}

/// Salary-change history → the "salary evolution" factor (12-month growth %).
/// Sensitive like Employee.salary: read only where `salary:read:all` holds.
model SalaryChange {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
effectiveDate DateTime
amount Int // new annual salary, org currency (as Employee.salary)
reason String?
createdAt DateTime @default(now())

@@index([employeeId, effectiveDate])
}

/// Internal-survey scores → the "engagement" weak signal (feedbacks internes).
/// No free text on this hot-path model — numeric score only, no-PII contract.
model EngagementSurvey {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
score Int // 0–10 (range validated in the write path, not the DB)
surveyDate DateTime
source String? // campaign label (e.g. "quarterly-pulse") — never PII
createdAt DateTime @default(now())

@@index([employeeId, surveyDate])
}

/// Adjustable coefficients (HR recalibration). Versioned + retained: editing
/// activates a NEW row so past snapshots stay reproducible against their weights.
model PredictiveWeightConfig {
id String @id @default(cuid())
version Int @unique @default(autoincrement())
weights Json // { seniority, absenteeism, review, salary, turnover, jobProfile, burnout, roleStagnation, dominoEffect, engagement }
thresholds Json // { medium, high }
active Boolean @default(true)
updatedById String? // raw id, audit-style
createdAt DateTime @default(now())

@@index([active])
}

/// A computed departure-risk score for one employee at a point in time. Powers
/// the risk map, 12-month projection, history, and accuracy backtesting. `factors`
/// stores the explicable FactorContribution[] breakdown (no black box).
model DepartureRiskSnapshot {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
score Int // 0–100
band RiskBand
factors Json // FactorContribution[] from computeDepartureRisk
weightVersion Int // which PredictiveWeightConfig produced it (reproducibility)
computedAt DateTime @default(now())
// Accuracy backtest: null until the outcome window elapses                            ; true if the
// employee actually left within it. Never PII — a bare outcome flag.
departedWithin90d Boolean?

@@index([employeeId, computedAt])
@@index([band])
}

// ─────────────────────────────────────────────────────────────────────────
// HR document generation (HARI-88 / SCRUM-078)
// ─────────────────────────────────────────────────────────────────────────

/// Document types that can be generated. Sprint 4 supports WORK_CERTIFICATE only.
enum GeneratedDocumentType {
WORK_CERTIFICATE
}

/// Lifecycle of a generated document request.
enum GeneratedDocumentStatus {
REQUESTED // employee submitted the request
VALIDATED // HR approved, PDF generation queued
GENERATED // PDF produced, download link available
DOWNLOADED // employee has downloaded the document
REJECTED // HR rejected the request
}

/// HARI-88 / SCRUM-078: an HR document requested by an employee (e.g. work certificate).
/// Drives the full generation workflow: request → HR validation → PDF generation → download.
/// PDF generation (SCRUM-081) and MinIO storage are deferred                                       ; pdfUrl is reserved for that sprint.
model GeneratedDocument {
id String @id @default(cuid())
type GeneratedDocumentType
status GeneratedDocumentStatus @default(REQUESTED)

// Requester — SetNull so the record outlives account deletion.
requestedBy User? @relation("DocumentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
requestedById String?

// HR validator — null until HR acts on the request.
validatedBy User? @relation("DocumentValidator", fields: [validatedById], references: [id], onDelete: SetNull)
validatedById String?

// Required when status = REJECTED, null otherwise.
rejectionNote String?

// The requester's locale at request time (not whoever happens to generate the
// PDF) — the app only has a per-browser cookie, no per-account locale, so this
// is captured once and used to render the certificate in the requester's own
// language regardless of who fulfills it.
locale String @default("en")

// MinIO object key of the generated PDF (documents/<id>.pdf) ; null until GENERATED.
// Set by generateWorkCertificate (SCRUM-081)                 ; served via the download proxy route.
pdfUrl String?

// Workflow timestamps — one per lifecycle transition.
requestedAt DateTime @default(now())
validatedAt DateTime?
generatedAt DateTime?
downloadedAt DateTime?
rejectedAt DateTime?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@index([requestedById])
@@index([validatedById])
@@index([status])
@@index([type])
@@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SCRUM-099 — Engagement & burnout/boreout. The scoring math lives in
// `lib/engagement/engagement.ts` (pure)                                                                                                                                                                                       ; these tables hold the qualitative
// signal inputs and the daily snapshots. Snapshots/alerts store scores, the
// 2-D vector, quadrant, and factor KEYS only — never names or raw notes.
// ─────────────────────────────────────────────────────────────────────────

/// Engagement band (ticket thresholds): GREEN 80–100 · YELLOW 60–79 · ORANGE 40–59 · RED 0–39.
enum EngagementBand {
GREEN
YELLOW
ORANGE
RED
}

/// 2-D diagnosis quadrant (exhaustion × disengagement).
enum EngagementQuadrant {
ENGAGED
BURNOUT
BOREOUT
STRAINED
}

/// Trust in a score given data availability (gates alerts for thin-data new hires).
enum Confidence {
LOW
MEDIUM
HIGH
}

/// Daily engagement snapshot. No PII — score, the 2-D vector, quadrant, and the
/// explicable factor breakdown (keys + signed points) only.
model EngagementSnapshot {
id String @id @default(cuid())
employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
score Int // 0–100, EMA-smoothed (100 = most engaged)
band EngagementBand
exhaustion Int // 0–100 (Y axis)
disengagement Int // 0–100 (X axis)
quadrant EngagementQuadrant
factors Json // EngagementFactor[] from computeEngagement (explains the raw daily reading)
momentum Float? // slope over the trailing 4 weeks (early-warning velocity)
confidence Confidence @default(LOW)
dataCoverage Int // % of signals with data, 0–100
weightVersion Int // which EngagementSignalConfig produced it
computedAt DateTime @default(now())

@@index([employeeId, computedAt])
@@index([band])
}

/// Manager-entered qualitative ratings. Attributed to the rater + period so a
/// successor manager never sees a prior manager's raw numbers (only the aggregate).
model QualitativeSignal {
id String @id @default(cuid())
employee Employee @relation("QualSubject", fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
raterId String // User id of the rating manager (gating + audit)
period DateTime // the month this rating applies to
workQuality Int // 1–5
participation Int // 1–5
peerInteraction Int // 1–5
note String? // HR + authoring-manager only — never the subject
createdAt DateTime @default(now())

@@unique([employeeId, raterId, period])
@@index([employeeId, period])
}

/// 1:1 check-in log → the "time since last 1:1" signal.
model OneOnOne {
id String @id @default(cuid())
employee Employee @relation("CheckInSubject", fields: [employeeId], references: [id], onDelete: Cascade)
employeeId String
managerId String
heldAt DateTime
createdAt DateTime @default(now())

@@index([employeeId, heldAt])
}

/// Versioned recalibration config (mirror PredictiveWeightConfig). HR-only.
model EngagementSignalConfig {
id String @id @default(cuid())
version Int @unique @default(autoincrement())
baseline Int @default(82)
weights Json // EngagementWeights
thresholds Json // { greenMin, yellowMin, orangeMin }
active Boolean @default(true)
updatedById String?
createdAt DateTime @default(now())

@@index([active])
}

// ─────────────────────────────────────────────────────────────────────────
// Authentication tokens (HARI-AUTH): password reset, passwordless magic link,
// and email one-time codes (OTP). A single table backs all three flows. Only a
// SHA-256 HASH of the secret is stored — never the raw link token or the code —
// so a database leak can't be replayed. Rows are single-use (consumedAt) and
// short-lived (expiresAt)                                                                                                                                                                                                     ; a background/lazy sweep can delete expired rows.
// ─────────────────────────────────────────────────────────────────────────
enum AuthTokenType {
PASSWORD_RESET
MAGIC_LINK
EMAIL_OTP
// Onboarding an invited account: HR provisions the User/Employee, this token
// lets them set their first password. Provisioning still happens server-side —
// sign-in never creates an account.
INVITE
}

model AuthToken {
id String @id @default(cuid())
type AuthTokenType
identifier String // the target email, lowercased
tokenHash String // SHA-256 of the raw secret (link token or OTP code)
expiresAt DateTime
consumedAt DateTime? // set once, on first successful verification
attempts Int @default(0) // failed verification attempts (OTP throttle)
createdAt DateTime @default(now())

@@index([identifier, type])
@@index([tokenHash])
@@index([expiresAt])
}
