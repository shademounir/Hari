# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Docker Compose reads `.env` automatically.
# ─────────────────────────────────────────────────────────────

# Postgres. Compose overrides the host to `db` for the app container;
# this value is used when running the app on the host (npm run dev).
DATABASE_URL="postgresql://hr:hr@localhost:5432/hr?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me-please-0123456789abcdef"
# Public base URL used to build links inside auth emails (reset / magic link).
# This local default works for dev. REQUIRED in production: getBaseUrl() fails
# closed there and refuses to derive the origin from the request Host header
# (host-header poisoning → reset-link account takeover).
AUTH_URL="http://localhost:3000"

# ── Passwordless & OAuth (all optional) ──────────────────────
# Google sign-in: the "Continue with Google" button + provider only appear when
# BOTH are set. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth emails (password reset, magic link, OTP). This starter has NO bundled mail
# transport: messages are written to the server log, so every flow works in dev.
# In development the link/code is also shown on-screen; set to "false" to hide it.
# Wire a real provider in src/lib/auth/email.ts for production delivery.
AUTH_REVEAL_DEV_SECRETS="true"

# ── AI providers ─────────────────────────────────────────────
# Powers BOTH chat AND RAG embeddings. Get a key at https://openrouter.ai/keys
# Chat uses free :free models; embeddings use a free lightweight model
# (all-MiniLM-L6-v2, 384d). One key runs the whole demo.
OPENROUTER_API_KEY=""

# Optional: a direct OpenAI key (selectable as an alternative chat provider).
# Adds the "(paid)" GPT models to the picker and BILLS YOUR OWN OpenAI account,
# so it is never the default — the free OpenRouter router stays the default.
# Worth setting when a free model has to be relied on for a demo: free ids get
# retired without notice, paid ones don't. Chat only; embeddings still run
# through OPENROUTER_API_KEY (see below — the 384d column is fixed).
OPENAI_API_KEY=""

# Optional: Vercel AI Gateway (selectable as an alternative chat provider).
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=""

# Optional: swap the embedding model. Safe for any OTHER 384-dim model
# (e.g. sentence-transformers/paraphrase-minilm-l6-v2). A different dimension
# needs a new Prisma migration to ALTER the halfvec column — see embeddings.ts.
# EMBEDDING_MODEL="sentence-transformers/all-minilm-l6-v2"

# ── Object storage (MinIO / S3) for Knowledge Base cover images ──
# Compose runs a `minio` service and overrides S3_ENDPOINT to http://minio:9000
# for the app container; this localhost value is used by `npm run dev` on the host.
# The MINIO_ROOT_* creds double as the app's S3 credentials in dev.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="kb-images"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# SCRUM-098 — secret guarding the 24h predictive-scoring cron
# (GET /api/cron/predictive-scores). Vercel Cron sends this as a Bearer token
# when set; the route fails closed if it is unset. Use a long random value.
CRON_SECRET=""

# SCRUM-081 — company name printed on generated HR documents (work certificates).
# Defaults to "HARI" if unset.
COMPANY_NAME="HARI"
